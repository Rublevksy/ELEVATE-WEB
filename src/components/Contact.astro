---
// PLACEHOLDER CONTACT ADDRESS — swap for the real studio inbox before
// launch. This is the only mechanism decided so far (mailto); a booking
// link or embedded form both remain open per the shape brief and need a
// decision before they'd replace this.
const email = 'kontakt@elevate.cz';
---

<section class="contact" id="kontakt">
  <div class="container">
    <h2 class="contact-lede">Máte projekt, který potřebuje jasný fokus?</h2>

    <a href={`mailto:${email}`} class="contact-link">
      <span>Domluvit konzultaci</span>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>

    <div class="contact-meta">
      <span>{email}</span>
      <span>Praha, Česká republika</span>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--sp-9);
    border-top: 1px solid var(--edge);
  }

  .contact-lede {
    /* Overrides the global h2 uppercase/heavy-weight rule: this reads as a
       quiet lede above the giant link, not a display headline. */
    text-transform: none;
    font-weight: 380;
    letter-spacing: normal;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--near);
    margin-bottom: var(--sp-5);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    text-decoration: none;
    color: var(--resolved);
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1;
  }

  .contact-link svg {
    width: clamp(1.6rem, 4vw, 2.8rem);
    height: clamp(1.6rem, 4vw, 2.8rem);
    flex: none;
    color: var(--beam);
    transition: transform var(--rack-fast);
  }

  .contact-link:hover svg {
    transform: translate(4px, -4px);
  }

  .contact-link:hover {
    color: var(--beam);
  }

  .contact-meta {
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    font-size: 0.86rem;
    /* --near, not --far: the email and city are real content, not a
       decorative label, so they need the 4.5:1 body-text floor. */
    color: var(--near);
  }

  @media (max-width: 700px) {
    .contact {
      padding-block: var(--sp-8);
    }

    .contact-link {
      gap: var(--sp-3);
    }
  }
</style>
