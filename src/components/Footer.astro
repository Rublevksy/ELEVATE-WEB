---
// Deliberately no legal-page links yet (Privacy / Terms): neither page
// exists, and a link to "#" is worse than no link. Add both the moment
// real pages exist rather than shipping dead anchors.
const year = new Date().getFullYear();
const links = [
  { href: '#proces', label: 'Proces' },
  { href: '#dukaz', label: 'Přístup' },
  { href: '#kontakt', label: 'Kontakt' },
];
---

<footer class="footer">
  <div class="container footer-grid">
    <a href="#hlavni" class="footer-brand" aria-label="ELEVATE, domů">
      <img src="/logo-elevate.png" alt="ELEVATE" width="120" height="26" />
    </a>

    <nav class="footer-links" aria-label="Navigace v patičce">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>

    <p class="footer-copy">© {year} ELEVATE. Všechna práva vyhrazena.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--edge);
    padding-block: var(--sp-6);
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5) var(--sp-6);
  }

  .footer-brand {
    display: flex;
    align-items: center;
  }

  .footer-brand img {
    height: 18px;
    width: auto;
    opacity: 0.75;
  }

  .footer-links {
    display: flex;
    gap: var(--sp-5);
    flex: 1;
  }

  .footer-links a {
    text-decoration: none;
    /* --near, not --far: at this size (13.6px, regular weight) --far reads
       ~3.15:1 on --depth, under the 4.5:1 body-text floor. --far stays
       reserved for large text or decorative labels. */
    color: var(--near);
    font-size: 0.85rem;
    transition: color var(--rack-fast);
  }

  .footer-links a:hover {
    color: var(--resolved);
  }

  .footer-copy {
    margin: 0;
    font-size: 0.8rem;
    color: var(--near);
    max-width: none;
  }

  @media (max-width: 700px) {
    .footer-grid {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
